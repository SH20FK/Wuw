# URL, на котором хостится сайт (используется для metadataBase / OG-изображений)
APP_URL="https://sh20fk.ru"

# Last.fm API key для блока Now Playing и страницы /music
LASTFM_API_KEY="YOUR_LASTFM_API_KEY"

# Telegram Bot API — уведомления из формы на /contact
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Cloudflare Turnstile
# Локально code автоматически использует always-pass тестовые ключи,
# боевые включаются только на домене из app/api/turnstile-config/route.ts.
# Актуальные тестовые ключи (2026): sitekey 1x00000000000000000000BB, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000BB"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
